${confDir}/niri/window-label.theme.css
/*
 * Generated by HyDE wallbash on every theme / wallpaper change.
 * Template: ~/.config/hyde/wallbash/always/niri-window-label.dcol
 * Do not edit: put your own tweaks in ~/.config/niri/window-label.css (loaded after this file).
 * Mapping follows HyDE's rofi/waybar conventions. The gold "custom name" colors are kept
 * on purpose: they mean "you renamed this window", whatever the theme.
 */
@define-color nwl_bg          <wallbash_pry1_rgba(0.96)>;
@define-color nwl_border      <wallbash_pry3_rgba(0.90)>;
@define-color nwl_accent      #<wallbash_4xa7>;
@define-color nwl_focus       #<wallbash_pry4>;
@define-color nwl_text        #<wallbash_1xa9>;
@define-color nwl_text_dim    <wallbash_1xa8_rgba(0.80)>;
@define-color nwl_text_bright #<wallbash_txt1>;
@define-color nwl_muted       #<wallbash_1xa5>;
