def monotonic_timestamp() -> dict[str, int]:
    """Same clock niri uses for focus_timestamp (CLOCK_MONOTONIC), so MRU order stays consistent."""
    ns = time.monotonic_ns()
    return {"secs": ns // 1_000_000_000, "nanos": ns % 1_000_000_000}


def mru_window_ids(windows: dict[int, dict], focused_id: int | None) -> list[int]:
    """Most-recently-used order: focused window first, then by focus timestamp (newest first)."""
    def key(w: dict) -> tuple[int, int]:
        t = w.get("focus_timestamp") or {}
        return (t.get("secs", 0), t.get("nanos", 0))

    ordered = [w["id"] for w in sorted(windows.values(), key=key, reverse=True)]
    if focused_id in windows:
        ordered.remove(focused_id)
        ordered.insert(0, focused_id)
    return ordered


CIRCLED_DIGITS = "①②③④⑤⑥⑦⑧⑨"


def ordered_output_names(outputs: dict[str, dict]) -> list[str]:
    """Monitors in physical order (left→right, then top→bottom) so 1, 2… match the desk."""
    def key(name: str) -> tuple[int, int, str]:
        lg = outputs[name].get("logical") or {}
        return (int(lg.get("x", 0)), int(lg.get("y", 0)), name)

    return sorted(outputs, key=key)


def load_monitor_names() -> dict[str, str]:
    """Optional user names, e.g. {"VGA-1": "Lateral"} in ~/.config/niri/monitor-names.json."""
    try:
        if MONITOR_NAMES_FILE.exists():
            data = json.loads(MONITOR_NAMES_FILE.read_text(encoding="utf-8"))
            return {str(k): str(v) for k, v in data.items() if v}
    except Exception:
        pass
    return {}


def monitor_display_name(name: str, output: dict, custom: dict[str, str] | None = None) -> str:
    """Friendly monitor name: user override, 'Laptop' for built-in panels, else the model."""
    if custom and custom.get(name):
        return custom[name]
    if name.startswith(("eDP", "LVDS", "DSI")):
        return tr("alttab_laptop")
    model = (output.get("model") or "").strip()
    make = (output.get("make") or "").strip()
    if model and not model.lower().startswith("0x"):
        return model
    return make or name


def monitor_badge(index: int) -> str:
    return CIRCLED_DIGITS[index] if 0 <= index < len(CIRCLED_DIGITS) else str(index + 1)


def notify_daemon(sig: int = signal.SIGUSR1) -> None:
    if PID_FILE.exists():
        try:
            pid = int(PID_FILE.read_text().strip())
            os.kill(pid, sig)
        except Exception:
            pass


def _read_child_pids(pid_str: str) -> list[str]:
    cpath = Path(f"/proc/{pid_str}/task/{pid_str}/children")
    try:
        return cpath.read_text().split() if cpath.exists() else []
    except Exception:
        return []


def _collect_process_tree_pids(root_pid: int | None, max_depth: int = 4) -> list[str]:
    """Traverse child process trees in /proc up to max_depth levels without nested loops."""
    if not root_pid:
        return []
    result: list[str] = []
    current_level = [str(root_pid)]
    for _ in range(max_depth):
        next_level = list(itertools.chain.from_iterable(map(_read_child_pids, current_level)))
        if not next_level:
            break
        result.extend(next_level)
        current_level = next_level
    result.append(str(root_pid))
    return result


def _read_pid_cwd(pid_str: str) -> str | None:
    try:
        return os.readlink(f"/proc/{pid_str}/cwd")
    except Exception:
        return None


def get_project_folder_name(pid: int | None) -> str | None:
    """Detect the current project directory name (cwd) from child/grandchild processes."""
    if not pid:
        return None
    home = str(Path.home())
    pids = _collect_process_tree_pids(pid)
    for p in reversed(pids[:-1]):
        cwd = _read_pid_cwd(p)
        if cwd and cwd not in (home, "/"):
            return Path(cwd).name
    return None


TERMINAL_APP_IDS = {
    "kitty", "alacritty", "foot", "footclient", "com.mitchellh.ghostty", "ghostty",
    "org.wezfurlong.wezterm", "wezterm", "org.gnome.console", "org.gnome.terminal",
    "org.kde.konsole", "konsole", "xterm", "st", "tilix", "com.raggesilver.blackbox",
}


def is_terminal_window(w: dict) -> bool:
    """Only terminal emulators get OSC titles; writing to a non-terminal app's PTY would
    hit whatever terminal launched it."""
    return (w.get("app_id") or "").lower() in TERMINAL_APP_IDS


def set_terminal_pty_title(pid: int | None, target_title: str) -> bool:
    """If the window belongs to a Linux terminal emulator (kitty, Alacritty, foot, Ghostty, WezTerm, etc.),
    send the standard OSC 2 escape sequence to its /dev/pts/* device to update its Wayland/Alt+Tab title."""
    if not pid:
        return False
    candidates = itertools.product(_collect_process_tree_pids(pid), ("0", "1", "2"))
    for p, fd in candidates:
        try:
            target = os.readlink(f"/proc/{p}/fd/{fd}")
            if target.startswith("/dev/pts/"):
                with open(target, "w", encoding="utf-8", errors="ignore") as f:
                    f.write(f"\033]2;{target_title}\007")
                return True
        except Exception:
            continue
    return False


def _abbreviate_home_path(path_str: str, home: str) -> str:
    if path_str == home:
        return "~"
    if not path_str.startswith(home + "/"):
        return path_str
    rel = path_str[len(home) + 1 :]
    parts = rel.split("/")
    return "~/…/" + "/".join(parts[-2:]) if len(parts) > 2 else "~/" + rel


def get_process_cwd(pid: int | None) -> str | None:
    if not pid:
        return None
    home = str(Path.home())
    cwds = [c for c in map(_read_pid_cwd, _collect_process_tree_pids(pid, max_depth=2)) if c]
    if not cwds:
        return None
    best_cwd = next((c for c in cwds if c != home), cwds[0])
    return _abbreviate_home_path(best_cwd, home)


def _find_gdk_monitor_for_workspace(ws_id: int | None, gdk_module):
    """Return the Gdk.Monitor hosting the given workspace ID, or None if not found."""
    if ws_id is None:
        return None
    try:
        wss = json.loads(subprocess.check_output(["niri", "msg", "--json", "workspaces"], text=True))
        outs = json.loads(subprocess.check_output(["niri", "msg", "--json", "outputs"], text=True))
        out_name = next((w.get("output") for w in wss if w.get("id") == ws_id), None)
        if not out_name or out_name not in outs:
            return None
        ox = int((outs[out_name].get("logical") or {}).get("x", 0))
        display = gdk_module.Display.get_default()
        if not display:
            return None
        monitors = (display.get_monitor(i) for i in range(display.get_n_monitors()))
        return next((m for m in monitors if abs(m.get_geometry().x - ox) < 50), None)
    except Exception:
        return None


def show_gtk_rename_dialog(
    app_id: str, title: str, current_name: str, ws_id: int | None
) -> str | None:
    import gi

    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    gi.require_version("GtkLayerShell", "0.1")
    from gi.repository import Gdk, Gtk, GtkLayerShell

    result: list[str | None] = [None]

    css = b"""
    window.rename-popup {
        background-color: transparent;
    }
    .rename-box {
        background-color: rgba(20, 22, 35, 0.97);
        border: 2px solid #e0af68;
        border-radius: 14px;
        padding: 16px 22px;
        margin: 8px;
    }
    .rename-header {
        color: #e0af68;
        font-size: 16px;
        font-weight: 800;
    }
    .rename-sub {
        color: #7aa2f7;
        font-size: 12px;
        margin-bottom: 6px;
    }
    entry.rename-entry {
        background-color: #11131d;
        background-image: none;
        color: #ffffff;
        caret-color: #e0af68;
        border: 1px solid #7aa2f7;
        border-radius: 8px;
        padding: 8px 12px;
        font-size: 18px;
        font-weight: 700;
        min-width: 420px;
    }
    .rename-hint {
        color: #9aa5ce;
        font-size: 11.5px;
        margin-top: 4px;
    }
    """
    provider = Gtk.CssProvider()
    provider.load_from_data(build_stylesheet(css))
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(),
        provider,
        Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
    )

    win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
    win.get_style_context().add_class("rename-popup")
    win.set_decorated(False)
    win.set_resizable(False)
    win.set_app_paintable(True)

    screen = win.get_screen()
    visual = screen.get_rgba_visual()
    if visual:
        win.set_visual(visual)

    GtkLayerShell.init_for_window(win)
    GtkLayerShell.set_namespace(win, "niri-window-rename")
    GtkLayerShell.set_layer(win, GtkLayerShell.Layer.OVERLAY)
    GtkLayerShell.set_keyboard_mode(win, GtkLayerShell.KeyboardMode.EXCLUSIVE)

    # Detect which monitor hosts the focused window so the rename dialog opens on that same screen
    target_monitor = _find_gdk_monitor_for_workspace(ws_id, Gdk)
    if target_monitor:
        GtkLayerShell.set_monitor(win, target_monitor)

    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
    box.get_style_context().add_class("rename-box")

    hdr = Gtk.Label(label=tr("rename_header", app_id=app_id))
    hdr.get_style_context().add_class("rename-header")
    hdr.set_xalign(0.0)

    if current_name:
        sub_txt = tr("rename_sub_custom", current=current_name, title=truncate_text(title, 38))
    else:
        sub_txt = tr("rename_sub_orig", title=truncate_text(title, 48))
    sub = Gtk.Label(label=sub_txt)
    sub.get_style_context().add_class("rename-sub")
    sub.set_xalign(0.0)

    entry = Gtk.Entry()
    entry.get_style_context().add_class("rename-entry")
    # Always start empty so typing replaces the window name instead of appending to it
    entry.set_text("")
    entry.set_placeholder_text(tr("rename_placeholder"))

    hint = Gtk.Label(label=tr("rename_hint"))
    hint.get_style_context().add_class("rename-hint")
    hint.set_xalign(0.0)

    box.pack_start(hdr, False, False, 0)
    box.pack_start(sub, False, False, 0)
    box.pack_start(entry, False, False, 4)
    box.pack_start(hint, False, False, 0)
    win.add(box)

    def on_activate(_entry):
        result[0] = entry.get_text().strip()
        Gtk.main_quit()

    def on_key_press(_widget, event):
        if event.keyval == Gdk.KEY_Escape:
            result[0] = None
            Gtk.main_quit()
            return True
        return False

    entry.connect("activate", on_activate)
    win.connect("key-press-event", on_key_press)
    win.connect("show", lambda *_: entry.grab_focus())

    win.show_all()
    entry.grab_focus()
    Gtk.main()
    return result[0]


def cmd_rename(args: list[str]) -> int:
    try:
        out = subprocess.check_output(["niri", "msg", "--json", "focused-window"], text=True)
        win = json.loads(out)
    except Exception as e:
        print(tr("err_focused_win", err=e), file=sys.stderr)
        return 1

    if not win or "id" not in win:
        subprocess.run(["notify-send", "Niri", tr("no_focused_win")])
        return 1

    wid = str(win["id"])
    app_id = win.get("app_id") or "app"
    title = win.get("title") or tr("untitled")
    ws_id = win.get("workspace_id")
    names = load_custom_names()
    current_name = names.get(wid, "")

    if args:
        new_name = " ".join(args).strip()
    else:
        new_name = show_gtk_rename_dialog(app_id, title, current_name, ws_id)
        if new_name is None:
            return 0

    if new_name == "-" or new_name == "":
        names.pop(wid, None)
        set_terminal_pty_title(win.get("pid"), app_id)
    else:
        names[wid] = new_name
        set_terminal_pty_title(win.get("pid"), f"🏷️ {new_name}")

    save_custom_names(names)
    notify_daemon()
    return 0


def cmd_switcher() -> int:
    try:
        out = subprocess.check_output(["niri", "msg", "--json", "windows"], text=True)
        windows = json.loads(out)
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        return 1

    names = load_custom_names()
    entries = []
    id_map = {}

    def sort_key(w):
        wid = str(w["id"])
        has_custom = 0 if wid in names else 1
        ws = w.get("workspace_id") or 99
        pos = (w.get("layout") or {}).get("pos_in_scrolling_layout") or [99, 99]
        return (has_custom, ws, pos[0], pos[1])

    for w in sorted(windows, key=sort_key):
        wid = str(w["id"])
        custom = names.get(wid)
        app = w.get("app_id") or "app"
        title = truncate_text(w.get("title") or "", 45)
        pos = (w.get("layout") or {}).get("pos_in_scrolling_layout")
        col_str = f"Col {pos[0]}" if pos else "Float"
        cwd = get_process_cwd(w.get("pid"))
        cwd_str = f" 📁 {cwd}" if cwd and cwd != "~" else ""

        if custom:
            label = f"🏷️ {custom}   │   [{app}] {title}{cwd_str} ({col_str})  #{wid}"
        else:
            label = f"🪟 {title}   │   [{app}]{cwd_str} ({col_str})  #{wid}"
        entries.append(label)
        id_map[label] = wid

    if not entries:
        return 0

    proc = subprocess.run(
        ["rofi", "-dmenu", "-i", "-p", tr("search_window")],
        input="\n".join(entries),
        text=True,
        capture_output=True,
    )
    if proc.returncode == 0 and proc.stdout.strip():
        chosen = proc.stdout.strip()
        wid = id_map.get(chosen)
        if not wid and "#" in chosen:
            wid = chosen.rsplit("#", 1)[-1].strip()
        if wid:
            subprocess.run(["niri", "msg", "action", "focus-window", "--id", str(wid)])
    return 0


class LayoutStateEngine:
    """Pure geometry, scrolling-column state, and label-formatting engine (testable without GTK)."""

    GAP = 16.0

    def __init__(self):
        self.windows: dict[int, dict] = {}
        self.workspaces: dict[int, dict] = {}
        self.outputs: dict[str, dict] = {}
        self.workspace_view_x: dict[int, float] = {}
        self.forced_side: dict[int, str] = {}
        self.focused_id: int | None = None
        self.overview_open: bool = False

    @staticmethod
    def _focus_ts(win: dict) -> tuple[int, int]:
        t = win.get("focus_timestamp") or {"secs": 0, "nanos": 0}
        return (t.get("secs", 0), t.get("nanos", 0))

    @staticmethod
    def _clamp_viewport_x(
        vx: float, cx: float, cw: float, usable_w: float, forced: str | None = None
    ) -> float:
        if cw >= usable_w - 8.0 or forced == "left":
            return cx
        if forced == "right":
            return max(0.0, cx + cw - usable_w)
        if cx < vx:
            return cx
        if cx + cw > vx + usable_w:
            return cx + cw - usable_w
        return vx

    def _get_tiled_workspace_windows(self, ws_id: int) -> list[dict]:
        return [
            win
            for win in self.windows.values()
            if win.get("workspace_id") == ws_id
            and not win.get("is_floating")
            and (win.get("layout") or {}).get("pos_in_scrolling_layout")
        ]

    def _measure_columns(
        self, ws_wins: list[dict], usable_w: float, mon_h: int
    ) -> tuple[dict[int, float], dict[int, float], dict[int, dict[int, float]]]:
        cols_width: dict[int, float] = {}
        col_rows_height: dict[int, dict[int, float]] = {}
        for win in ws_wins:
            wlayout = win.get("layout") or {}
            c, r = wlayout["pos_in_scrolling_layout"]
            ts = wlayout.get("tile_size") or [usable_w, float(mon_h)]
            cols_width[c] = max(cols_width.get(c, 0.0), float(ts[0]))
            col_rows_height.setdefault(c, {})[r] = float(ts[1])

        col_x: dict[int, float] = {}
        cur_x = 0.0
        for c in sorted(cols_width):
            col_x[c] = cur_x
            cur_x += cols_width[c] + self.GAP
        return cols_width, col_x, col_rows_height

    def _init_workspace_viewport(
        self, ws_wins: list[dict], col_x: dict[int, float], cols_width: dict[int, float], usable_w: float
    ) -> float:
        recent_wins = sorted(ws_wins, key=self._focus_ts)[-4:]
        first_col = recent_wins[0]["layout"]["pos_in_scrolling_layout"][0]
        vx = col_x.get(first_col, 0.0)
        for win in recent_wins:
            c = win["layout"]["pos_in_scrolling_layout"][0]
            vx = self._clamp_viewport_x(vx, col_x.get(c, 0.0), cols_width.get(c, usable_w), usable_w)
        return vx

    def _compute_window_geometry_on_output(
        self, w: dict, mon_w: int, mon_h: int, update_viewport: bool = True
    ) -> tuple[float, float, float]:
        """Compute (center_x, top_y, win_w) for the window relative to its output monitor."""
        layout = w.get("layout") or {}
        tile_size = layout.get("tile_size") or [float(mon_w), float(mon_h)]
        win_w = float(tile_size[0])

        tile_pos = layout.get("tile_pos_in_workspace_view")
        if tile_pos is not None:
            return float(tile_pos[0]) + win_w / 2.0, float(tile_pos[1]), win_w

        pos = layout.get("pos_in_scrolling_layout")
        ws_id = w.get("workspace_id")
        if not pos or ws_id is None:
            return mon_w / 2.0, self.GAP, win_w

        ws_wins = self._get_tiled_workspace_windows(ws_id)
        if not ws_wins:
            return mon_w / 2.0, self.GAP, win_w

        target_col, target_row = int(pos[0]), int(pos[1])
        usable_w = float(mon_w) - 2.0 * self.GAP
        cols_width, col_x, col_rows_height = self._measure_columns(ws_wins, usable_w, mon_h)

        if ws_id not in self.workspace_view_x:
            self.workspace_view_x[ws_id] = self._init_workspace_viewport(
                ws_wins, col_x, cols_width, usable_w
            )

        vx = self.workspace_view_x.get(ws_id, 0.0)
        cx = col_x.get(target_col, 0.0)
        cw = cols_width.get(target_col, win_w)

        if update_viewport:
            vx = self._clamp_viewport_x(vx, cx, cw, usable_w, self.forced_side.get(w.get("id")))
            self.workspace_view_x[ws_id] = vx

        center_x = self.GAP + (cx - vx) + (cw / 2.0)
        rows_in_col = col_rows_height.get(target_col, {})
        top_y = self.GAP + sum(h + self.GAP for r, h in rows_in_col.items() if r < target_row)
        return center_x, top_y, cw

    def _format_label_for_window(
        self, w: dict, names: dict[str, str], project_override: str | None = None
    ) -> tuple[str, bool]:
        wid = str(w.get("id"))
        custom_name = names.get(wid)
        if custom_name:
            return truncate_text(custom_name, 56), True

        raw_title = strip_minimap_from_title(w.get("title") or w.get("app_id") or tr("untitled"))
        proj = project_override if project_override is not None else get_project_folder_name(w.get("pid"))
        if not proj or proj.lower() in raw_title.lower():
            return truncate_text(raw_title, 56), False
        if raw_title in ("~", "", w.get("app_id") or ""):
            return truncate_text(proj, 56), False
        return truncate_text(f"{proj}  •  {raw_title}", 56), False

    def _is_window_fullscreen(self, w: dict, mon_w: int, mon_h: int) -> bool:
        wsize = (w.get("layout") or {}).get("window_size")
        return bool(
            isinstance(wsize, list)
            and len(wsize) == 2
            and int(wsize[0]) >= mon_w
            and int(wsize[1]) >= mon_h
        )

    def _apply_single_layout_change(self, wid: int, new_layout: dict) -> bool:
        if wid not in self.windows:
            return False
        old_pos = (self.windows[wid].get("layout") or {}).get("pos_in_scrolling_layout")
        new_pos = new_layout.get("pos_in_scrolling_layout")
        self.windows[wid]["layout"] = new_layout
        if wid != self.focused_id or not old_pos or not new_pos or new_pos[0] == old_pos[0]:
            return False
        self.forced_side[wid] = "left" if new_pos[0] < old_pos[0] else "right"
        return True


def load_minimap_engine(custom_path: Path | None = None):
    """Optionally connect to the companion niri-minimap tool if installed on the system."""
    if os.environ.get("NIRI_DISABLE_MINIMAP") == "1":
        return None
    import importlib.machinery
    import importlib.util

    candidates = [
        custom_path,
        Path(os.environ["NIRI_MINIMAP_PATH"]) if "NIRI_MINIMAP_PATH" in os.environ else None,
        Path(__file__).resolve().parent / "niri-minimap",
        Path.home() / ".local" / "bin" / "niri-minimap",
    ]
    target = next((p for p in candidates if p is not None and p.exists()), None)
    if not target:
        return None
    try:
        loader = importlib.machinery.SourceFileLoader("niri_minimap_plugin", str(target))
        spec = importlib.util.spec_from_loader(loader.name, loader)
        mod = importlib.util.module_from_spec(spec)
        loader.exec_module(mod)
        return mod.MinimapEngine()
    except Exception:
        return None


def run_daemon() -> None:
    import cairo
    import gi

    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    gi.require_version("GtkLayerShell", "0.1")
    from gi.repository import Gdk, GLib, Gtk, GtkLayerShell

    try:
        gi.require_version("GioUnix", "2.0")
        from gi.repository.GioUnix import DesktopAppInfo
    except (ImportError, ValueError):
        from gi.repository.Gio import DesktopAppInfo

    PID_FILE.write_text(str(os.getpid()))

    style_provider = Gtk.CssProvider()
    style_state = {"mtime": None}

    def reload_styles_if_changed() -> None:
        """Re-read the theme / user stylesheets when either changed (theme switches apply live)."""
        def stamp(path: Path) -> float | None:
            try:
                return path.stat().st_mtime
            except OSError:
                return None

        mtime = (stamp(THEME_STYLE_FILE), stamp(STYLE_FILE))
        if mtime == style_state["mtime"] and style_state.get("loaded"):
            return
        try:
            style_provider.load_from_data(build_stylesheet(DEFAULT_CSS))
        except GLib.Error as e:
            print(f"window-label css: {e.message}; using defaults", file=sys.stderr)
            style_provider.load_from_data(DEFAULT_CSS)
        style_state.update(mtime=mtime, loaded=True)

    reload_styles_if_changed()
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(),
        style_provider,
        Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
    )

    class MonitorBadgeWindow:
        """An independent layer-shell overlay window bound to a specific physical monitor."""

        def __init__(self, gdk_monitor: Gdk.Monitor):
            self.gdk_monitor = gdk_monitor
            self.win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
            self.win.get_style_context().add_class("niri-badge-window")
            self.win.set_decorated(False)
            self.win.set_resizable(False)
            self.win.set_app_paintable(True)

            screen = self.win.get_screen()
            visual = screen.get_rgba_visual()
            if visual:
                self.win.set_visual(visual)

            GtkLayerShell.init_for_window(self.win)
            GtkLayerShell.set_namespace(self.win, "niri-window-label")
            GtkLayerShell.set_monitor(self.win, gdk_monitor)
            GtkLayerShell.set_layer(self.win, GtkLayerShell.Layer.OVERLAY)
            GtkLayerShell.set_anchor(self.win, GtkLayerShell.Edge.TOP, True)
            GtkLayerShell.set_anchor(self.win, GtkLayerShell.Edge.LEFT, True)
            GtkLayerShell.set_keyboard_mode(self.win, GtkLayerShell.KeyboardMode.NONE)

            self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
            self.box.get_style_context().add_class("badge-box")

            self.title_lbl = Gtk.Label()
            self.title_lbl.get_style_context().add_class("title-label")
            self.title_lbl.set_line_wrap(False)

            self.minimap_lbl = Gtk.Label()
            self.minimap_lbl.get_style_context().add_class("minimap-strip")
            self.minimap_lbl.set_use_markup(True)
            self.minimap_lbl.set_no_show_all(True)

            self.box.pack_start(self.title_lbl, False, False, 0)
            self.box.pack_start(self.minimap_lbl, False, False, 0)
            self.win.add(self.box)

            self.win.connect("realize", self._make_click_through)
            self.win.connect("size-allocate", lambda *_: self._make_click_through(self.win))

        def _make_click_through(self, widget):
            gdk_win = widget.get_window()
            if gdk_win:
                empty_region = cairo.Region(cairo.RectangleInt(0, 0, 0, 0))
                gdk_win.input_shape_combine_region(empty_region, 0, 0)

        def show_badge(
            self,
            title_text: str,
            is_custom: bool,
            center_x: float,
            top_y: float,
            mon_width: int,
            mon_height: int,
            minimap_markup: str = "",
        ):
            for ctx in (self.box.get_style_context(), self.title_lbl.get_style_context()):
                if is_custom:
                    ctx.add_class("custom-named")
                else:
                    ctx.remove_class("custom-named")

            self.title_lbl.set_text(title_text)
            if minimap_markup:
                self.minimap_lbl.set_markup(minimap_markup)
                self.minimap_lbl.show()
            else:
                self.minimap_lbl.hide()
            self.box.show_all()

            _min_w, nat_w = self.box.get_preferred_width()
            _min_h, nat_h = self.box.get_preferred_height()
            badge_w = max(nat_w, 80)
            badge_h = max(nat_h, 36)

            left_margin = max(16, min(mon_width - badge_w - 16, int(center_x - (badge_w / 2.0))))
            top_margin = max(16, min(mon_height - badge_h - 16, int(top_y + 24)))

            GtkLayerShell.set_margin(self.win, GtkLayerShell.Edge.LEFT, left_margin)
            GtkLayerShell.set_margin(self.win, GtkLayerShell.Edge.TOP, top_margin)

            self.win.show_all()
            self.win.queue_resize()
            self._make_click_through(self.win)

        def hide(self):
            self.win.hide()

    class BadgeController(LayoutStateEngine):
        def __init__(self):
            super().__init__()
            self.hide_timer_id: int | None = None
            self.monitor_pools: dict[tuple[int, int], list[MonitorBadgeWindow]] = {}
            self.minimap_engine = load_minimap_engine()

            self._refresh_outputs()
            self._init_gdk_monitors()

        def _compute_minimap_markup(
            self, w: dict, mon_w: int, mon_h: int, names: dict[str, str]
        ) -> str:
            if not self.minimap_engine:
                return ""
            self.minimap_engine.windows = self.windows
            self.minimap_engine.workspaces = self.workspaces
            self.minimap_engine.workspace_view_x = self.workspace_view_x
            self.minimap_engine.forced_side = self.forced_side
            cols = self.minimap_engine.compute_strip_state(
                w, mon_w, mon_h, names, update_viewport=False
            )
            return self.minimap_engine.format_strip_markup(cols, min_columns=2)

        def sync_window_pty_title(self, w: dict, names: dict[str, str]) -> None:
            """Tag custom-named terminals with '🏷️ name'; strip any leftover '⟪…⟫' strip."""
            if not is_terminal_window(w):
                return
            title = w.get("title") or ""
            cname = names.get(str(w.get("id")))
            if cname:
                desired = f"🏷️ {cname}"
            elif "⟪" in title and title.endswith("⟫"):
                desired = strip_minimap_from_title(title)
            else:
                return
            if title != desired:
                set_terminal_pty_title(w.get("pid"), desired)

        def sync_all_pty_titles(self, names: dict[str, str] | None = None) -> None:
            active_names = names if names is not None else load_custom_names()
            for w in list(self.windows.values()):
                self.sync_window_pty_title(w, active_names)

        def _all_badge_windows(self):
            return itertools.chain.from_iterable(self.monitor_pools.values())

        def _refresh_outputs(self):
            try:
                out = subprocess.check_output(["niri", "msg", "--json", "outputs"], text=True)
                self.outputs = json.loads(out)
            except Exception:
                pass

        def _init_gdk_monitors(self):
            display = Gdk.Display.get_default()
            if not display:
                return
            for i in range(display.get_n_monitors()):
                m = display.get_monitor(i)
                geom = m.get_geometry()
                key = (geom.x, geom.y)
                if key not in self.monitor_pools:
                    self.monitor_pools[key] = [MonitorBadgeWindow(m) for _ in range(4)]

        def _get_monitor_pool_for_output(
            self, output_name: str | None
        ) -> tuple[list[MonitorBadgeWindow], int, int]:
            self._init_gdk_monitors()
            if output_name and output_name not in self.outputs:
                self._refresh_outputs()

            if output_name and output_name in self.outputs:
                logical = self.outputs[output_name].get("logical") or {}
                ox = int(logical.get("x", 0))
                oy = int(logical.get("y", 0))
                ow = int(logical.get("width", 1920))
                oh = int(logical.get("height", 1080))
                if (ox, oy) in self.monitor_pools:
                    return self.monitor_pools[(ox, oy)], ow, oh
                matched = next(
                    (pool for (mx, _), pool in self.monitor_pools.items() if abs(mx - ox) < 50),
                    None,
                )
                if matched is not None:
                    return matched, ow, oh

            if self.monitor_pools:
                pool = next(iter(self.monitor_pools.values()))
                geom = pool[0].gdk_monitor.get_geometry()
                return pool, geom.width, geom.height
            return [], 1920, 1080

        def _schedule_hide(self, timeout_ms: int) -> None:
            if self.hide_timer_id is not None:
                GLib.source_remove(self.hide_timer_id)
            self.hide_timer_id = GLib.timeout_add(timeout_ms, self.hide_all)

        def show_for_window(self, wid: int | None, force: bool = False):
            if getattr(self, "alttab_active", lambda: False)():
                return
            reload_styles_if_changed()
            if self.overview_open or wid is None or wid not in self.windows:
                self.hide_all()
                return

            w = self.windows[wid]
            ws = self.workspaces.get(w.get("workspace_id")) or {}
            pool, mon_w, mon_h = self._get_monitor_pool_for_output(ws.get("output"))
            if not pool or (not force and self._is_window_fullscreen(w, mon_w, mon_h)):
                self.hide_all()
                return

            target_mwin = pool[0]
            for mwin in self._all_badge_windows():
                if mwin is not target_mwin:
                    mwin.hide()

            center_x, top_y, _cw = self._compute_window_geometry_on_output(
                w, mon_w, mon_h, update_viewport=True
            )
            names = load_custom_names()
            title_text, is_custom = self._format_label_for_window(w, names)

            open_ids = {str(k) for k in self.windows}
            cleaned = {k: v for k, v in names.items() if k in open_ids}
            if len(cleaned) != len(names):
                save_custom_names(cleaned)

            minimap_markup = self._compute_minimap_markup(w, mon_w, mon_h, names)
            target_mwin.show_badge(
                title_text, is_custom, center_x, top_y, mon_w, mon_h, minimap_markup
            )
            self._schedule_hide(2300)

        def _peek_single_workspace(self, ws_id: int, ws: dict, names: dict[str, str]) -> None:
            pool, mon_w, mon_h = self._get_monitor_pool_for_output(ws.get("output"))
            if not pool:
                return
            active_wid = ws.get("active_window_id")
            if active_wid and active_wid in self.windows:
                self._compute_window_geometry_on_output(
                    self.windows[active_wid], mon_w, mon_h, update_viewport=True
                )

            ws_wins = [win for win in self.windows.values() if win.get("workspace_id") == ws_id]
            slot_idx = 0
            for win in ws_wins:
                if slot_idx >= len(pool):
                    break
                center_x, top_y, _ = self._compute_window_geometry_on_output(
                    win, mon_w, mon_h, update_viewport=False
                )
                if 20.0 <= center_x <= (mon_w - 20.0):
                    title_text, is_custom = self._format_label_for_window(win, names)
                    minimap_markup = self._compute_minimap_markup(win, mon_w, mon_h, names)
                    pool[slot_idx].show_badge(
                        title_text, is_custom, center_x, top_y, mon_w, mon_h, minimap_markup
                    )
                    slot_idx += 1

        def peek_all_visible(self):
            """Peek mode: simultaneously display labels above all visible windows across active monitors."""
            if self.overview_open:
                return
            names = load_custom_names()
            self.hide_all()
            for ws_id, ws in self.workspaces.items():
                if ws.get("is_active"):
                    self._peek_single_workspace(ws_id, ws, names)
            self._schedule_hide(2800)

        def hide_all(self):
            for mwin in self._all_badge_windows():
                mwin.hide()
            self.hide_timer_id = None
            return False


    class AltTabSwitcher:
        """Custom Alt+Tab: a master strip of the selected window's workspace on top, MRU list below.
        Niri keeps handling the Alt+Tab bind (each press signals us); we grab the keyboard only
        to see Alt being released, Esc, Enter and arrow keys."""

        MAX_ROWS = 9
        MAX_STRIP_COLS = 15
        LIFETIME_MS = 20000

        def __init__(self, ctl: "BadgeController"):
            self.ctl = ctl
            self.win: Gtk.Window | None = None
            self.order: list[int] = []
            self.sel = 0
            self.active = False
            self.focused_in = False
            self.seen_alt = False
            self.opened_at = 0.0
            self._monitor_names: dict[str, str] = {}
            self.poll_id: int | None = None
            self.life_id: int | None = None

        # ---------- lifecycle ----------
        def step(self, delta: int) -> bool:
            if self.active:
                self._move(delta)
            else:
                self._open(delta)
            return False

        def _open(self, delta: int) -> None:
            ctl = self.ctl
            if ctl.overview_open:
                return
            self.order = mru_window_ids(ctl.windows, ctl.focused_id)
            if not self.order:
                return
            ctl._refresh_outputs()
            self._monitor_names = load_monitor_names()
            reload_styles_if_changed()
            self.sel = (1 if delta > 0 else -1) % len(self.order) if len(self.order) > 1 else 0
            ctl.hide_all()

            focused = ctl.windows.get(ctl.focused_id) or ctl.windows[self.order[0]]
            ws = ctl.workspaces.get(focused.get("workspace_id")) or {}
            pool, _mw, _mh = ctl._get_monitor_pool_for_output(ws.get("output"))
            gdk_monitor = pool[0].gdk_monitor if pool else None

            self._build(gdk_monitor)
            self.active = True
            self.focused_in = False
            self.seen_alt = False
            self.opened_at = time.monotonic()
            self._render()
            self.win.show_all()
            self.poll_id = GLib.timeout_add(25, self._poll_alt)
            self.life_id = GLib.timeout_add(self.LIFETIME_MS, self._cancel_timeout)

        def _close(self) -> None:
            self.active = False
            for attr in ("poll_id", "life_id"):
                tid = getattr(self, attr)
                if tid is not None:
                    GLib.source_remove(tid)
                    setattr(self, attr, None)
            if self.win is not None:
                self.win.destroy()
                self.win = None

        def commit(self) -> None:
            wid = self.order[self.sel] if self.order else None
            self._close()
            if wid is not None and wid in self.ctl.windows and wid != self.ctl.focused_id:
                subprocess.Popen(["niri", "msg", "action", "focus-window", "--id", str(wid)])
            else:
                GLib.idle_add(self.ctl.show_for_window, self.ctl.focused_id, True)

        def cancel(self) -> None:
            self._close()

        def _cancel_timeout(self) -> bool:
            self.life_id = None
            self.cancel()
            return False

        def _move(self, delta: int) -> None:
            self.order = [wid for wid in self.order if wid in self.ctl.windows]
            if not self.order:
                self.cancel()
                return
            self.sel = (self.sel + delta) % len(self.order)
            self._render()

        def _alt_held(self) -> bool:
            keymap = Gdk.Keymap.get_for_display(Gdk.Display.get_default())
            return bool(keymap.get_modifier_state() & Gdk.ModifierType.MOD1_MASK)

        def _debug(self, msg: str) -> None:
            if os.environ.get("NIRI_ALTTAB_DEBUG") == "1":
                print(f"[alttab {time.monotonic() - self.opened_at:6.3f}s] {msg}", file=sys.stderr, flush=True)

        def _poll_alt(self) -> bool:
            """Backup detector only. On Wayland GDK may not know about an Alt that was pressed
            before we got keyboard focus, so 'not held' is only trusted after we saw it held."""
            if not self.active:
                self.poll_id = None
                return False
            held = self._alt_held()
            if held and not self.seen_alt:
                self._debug("poll: Alt held")
                self.seen_alt = True
            elif not held and self.seen_alt:
                self._debug("poll: Alt released -> commit")
                self.poll_id = None
                self.commit()
                return False
            return True

        # ---------- input ----------
        def _on_focus_in(self, *_):
            self.focused_in = True
            self._debug(f"focus-in, poll sees Alt={self._alt_held()}")
            # wl_keyboard.modifiers follows enter; give it a moment, then catch the quick
            # Alt+Tab tap whose Alt release happened before we had the keyboard.
            GLib.timeout_add(40, self._check_alt_after_focus)
            return False

        def _check_alt_after_focus(self) -> bool:
            if self.active and not self.seen_alt and not self._alt_held():
                self._debug("Alt already released before focus -> commit")
                self.commit()
            return False

        def _on_key_press(self, _w, event) -> bool:
            key = Gdk.keyval_name(event.keyval) or ""
            self._debug(f"press {key} state={int(event.state)}")
            if key == "Escape":
                self.cancel()
            elif key in ("Return", "KP_Enter", "space"):
                self.commit()
            elif key in ("Right", "Down", "Tab", "l", "j"):
                self._move(1)
            elif key in ("Left", "Up", "ISO_Left_Tab", "h", "k"):
                self._move(-1)
            return True

        def _on_key_release(self, _w, event) -> bool:
            key = Gdk.keyval_name(event.keyval) or ""
            alt_in_state = bool(event.state & Gdk.ModifierType.MOD1_MASK)
            self._debug(f"release {key} state={int(event.state)} alt={alt_in_state}")
            if key in ("Alt_L", "Alt_R", "Meta_L", "Meta_R"):
                self.commit()
            elif key in ("Tab", "ISO_Left_Tab"):
                # Tab's release reaches us with the live modifier state: tells us if Alt is still down.
                if alt_in_state:
                    self.seen_alt = True
                else:
                    self.commit()
            return True

        def _on_row_click(self, idx: int) -> None:
            self.sel = idx
            self.commit()

        # ---------- drawing ----------
        def _build(self, gdk_monitor) -> None:
            win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
            win.get_style_context().add_class("niri-alttab-window")
            win.set_decorated(False)
            win.set_app_paintable(True)
            visual = win.get_screen().get_rgba_visual()
            if visual:
                win.set_visual(visual)
            GtkLayerShell.init_for_window(win)
            GtkLayerShell.set_namespace(win, "niri-window-alttab")
            GtkLayerShell.set_layer(win, GtkLayerShell.Layer.OVERLAY)
            GtkLayerShell.set_keyboard_mode(win, GtkLayerShell.KeyboardMode.EXCLUSIVE)
            if gdk_monitor is not None:
                GtkLayerShell.set_monitor(win, gdk_monitor)
            win.connect("key-press-event", self._on_key_press)
            win.connect("key-release-event", self._on_key_release)
            win.connect("focus-in-event", self._on_focus_in)

            outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
            outer.get_style_context().add_class("alttab-box")

            top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            self.monmap = Gtk.Fixed()
            self.monmap.set_valign(Gtk.Align.CENTER)
            top.pack_start(self.monmap, False, False, 0)
            self.monitor_name_lbl = Gtk.Label(xalign=0.0)
            self.monitor_name_lbl.get_style_context().add_class("alttab-monitor-name")
            self.monitor_name_lbl.set_no_show_all(True)
            top.pack_start(self.monitor_name_lbl, False, False, 0)
            self.header_lbl = Gtk.Label(xalign=0.0)
            self.header_lbl.get_style_context().add_class("alttab-header")
            self.counter_lbl = Gtk.Label(xalign=1.0)
            self.counter_lbl.get_style_context().add_class("alttab-counter")
            top.pack_start(self.header_lbl, True, True, 0)
            top.pack_end(self.counter_lbl, False, False, 0)

            self.strip_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=2)
            self.strip_box.set_halign(Gtk.Align.CENTER)
            self.strip_box.get_style_context().add_class("alttab-strip")

            self.sel_lbl = Gtk.Label()
            self.sel_lbl.get_style_context().add_class("alttab-selected")
            self.sel_lbl.set_ellipsize(3)  # Pango.EllipsizeMode.END
            self.sel_lbl.set_max_width_chars(60)

            self.list_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            hint = Gtk.Label(label=tr("alttab_hint"))
            hint.get_style_context().add_class("alttab-hint")

            outer.pack_start(top, False, False, 0)
            outer.pack_start(self.strip_box, False, False, 0)
            outer.pack_start(self.sel_lbl, False, False, 0)
            outer.pack_start(Gtk.Separator(), False, False, 4)
            outer.pack_start(self.list_box, False, False, 0)
            outer.pack_start(hint, False, False, 0)
            outer.set_size_request(560, -1)
            win.add(outer)
            self.win = win

        @staticmethod
        def _clear(box: Gtk.Box) -> None:
            for child in box.get_children():
                box.remove(child)
                child.destroy()

        def _strip_columns(self, w: dict) -> list[dict]:
            """Columns of w's workspace as if w were focused (viewport simulated on a copy)."""
            eng = self.ctl.minimap_engine
            if not eng or w.get("is_floating"):
                return []
            ws = self.ctl.workspaces.get(w.get("workspace_id")) or {}
            _pool, mon_w, mon_h = self.ctl._get_monitor_pool_for_output(ws.get("output"))
            eng.windows = self.ctl.windows
            eng.workspaces = self.ctl.workspaces
            eng.workspace_view_x = dict(self.ctl.workspace_view_x)
            eng.forced_side = {}
            return eng.compute_strip_state(w, mon_w, mon_h, load_custom_names(), update_viewport=True)

        def _render_strip(self, w: dict) -> None:
            self._clear(self.strip_box)
            cols = self._strip_columns(w)
            if not cols:
                self.counter_lbl.set_text("")
                lbl = Gtk.Label(label="◆  " + tr("alttab_floating") if w.get("is_floating") else "▣")
                lbl.get_style_context().add_class("alttab-col")
                lbl.get_style_context().add_class("focused")
                self.strip_box.pack_start(lbl, False, False, 0)
                return
            focus_idx = next((i for i, c in enumerate(cols) if c["is_focused"]), 0)
            self.counter_lbl.set_text(f"{focus_idx + 1}/{len(cols)}")
            # Slide a window over long strips so the selected column stays centered.
            n = self.MAX_STRIP_COLS
            start = max(0, min(len(cols) - n, focus_idx - n // 2)) if len(cols) > n else 0
            shown = cols[start:start + n]
            eng = self.ctl.minimap_engine
            if start > 0:
                self._add_ellipsis(f"‹{start}")
            for c in shown:
                lbl = Gtk.Label(label=eng._symbol_for_col(c))
                ctx = lbl.get_style_context()
                ctx.add_class("alttab-col")
                for flag, cls in (("is_focused", "focused"), ("is_visible", "visible"), ("has_custom", "custom")):
                    if c[flag]:
                        ctx.add_class(cls)
                self.strip_box.pack_start(lbl, False, False, 0)
            if start + n < len(cols):
                self._add_ellipsis(f"{len(cols) - start - n}›")

        def _add_ellipsis(self, text: str) -> None:
            lbl = Gtk.Label(label=text)
            lbl.get_style_context().add_class("alttab-col")
            lbl.get_style_context().add_class("ellipsis")
            self.strip_box.pack_start(lbl, False, False, 0)

        MONMAP_HEIGHT = 30.0
        MONMAP_GAP = 4

        def _render_monitor_map(self, active_output: str | None) -> None:
            """Monitors drawn to scale in their real arrangement, numbered left→right."""
            for child in self.monmap.get_children():
                self.monmap.remove(child)
                child.destroy()
            outputs = self.ctl.outputs
            names = ordered_output_names(outputs)
            if len(names) < 2:
                self.monmap.hide()
                return
            logicals = [outputs[n].get("logical") or {} for n in names]
            scale = self.MONMAP_HEIGHT / max(float(lg.get("height", 1080)) for lg in logicals)
            min_x = min(int(lg.get("x", 0)) for lg in logicals)
            min_y = min(int(lg.get("y", 0)) for lg in logicals)
            for idx, (name, lg) in enumerate(zip(names, logicals)):
                lbl = Gtk.Label(label=str(idx + 1))
                ctx = lbl.get_style_context()
                ctx.add_class("alttab-mon")
                if name == active_output:
                    ctx.add_class("active")
                w = max(18, int(float(lg.get("width", 1920)) * scale) - self.MONMAP_GAP)
                h = max(14, int(float(lg.get("height", 1080)) * scale) - self.MONMAP_GAP)
                lbl.set_size_request(w, h)
                x = int((int(lg.get("x", 0)) - min_x) * scale) + idx * self.MONMAP_GAP
                y = int((int(lg.get("y", 0)) - min_y) * scale)
                self.monmap.put(lbl, x, y)
            self.monmap.show_all()

        def _monitor_index(self, output_name: str | None) -> int:
            names = ordered_output_names(self.ctl.outputs)
            return names.index(output_name) if output_name in names else -1

        def _render_header(self, w: dict) -> None:
            ws = self.ctl.workspaces.get(w.get("workspace_id")) or {}
            out = ws.get("output")
            self.header_lbl.set_text(ws.get("name") or tr("alttab_workspace", idx=ws.get("idx", "?")))
            if out:
                mon = monitor_display_name(out, self.ctl.outputs.get(out) or {}, self._monitor_names)
                self.monitor_name_lbl.set_text(f"{mon}  ·")
                self.monitor_name_lbl.show()
            else:
                self.monitor_name_lbl.hide()

        @staticmethod
        def _app_icon(app_id: str) -> Gtk.Image:
            icon = None
            for cand in (app_id, app_id.lower()):
                try:
                    info = DesktopAppInfo.new(f"{cand}.desktop")
                except TypeError:
                    info = None
                if info and info.get_icon():
                    icon = info.get_icon()
                    break
            if icon is not None:
                img = Gtk.Image.new_from_gicon(icon, Gtk.IconSize.LARGE_TOOLBAR)
            else:
                img = Gtk.Image.new_from_icon_name(app_id.lower() or "application-x-executable",
                                                   Gtk.IconSize.LARGE_TOOLBAR)
            img.set_pixel_size(24)
            return img

        def _render_rows(self, names: dict[str, str]) -> None:
            self._clear(self.list_box)
            n = len(self.order)
            rows = min(self.MAX_ROWS, n)
            start = max(0, min(n - rows, self.sel - rows // 2))
            for idx in range(start, start + rows):
                w = self.ctl.windows[self.order[idx]]
                title, is_custom = self.ctl._format_label_for_window(w, names)
                row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
                row.get_style_context().add_class("alttab-row")
                if idx == self.sel:
                    row.get_style_context().add_class("selected")
                t = Gtk.Label(label=("🏷️ " if is_custom else "") + title, xalign=0.0)
                t.set_ellipsize(3)
                t.get_style_context().add_class("alttab-row-title")
                if is_custom:
                    t.get_style_context().add_class("custom-named")
                pos = (w.get("layout") or {}).get("pos_in_scrolling_layout")
                col_txt = f"col {pos[0]}" if pos else "float"
                ws = self.ctl.workspaces.get(w.get("workspace_id")) or {}
                mon_idx = self._monitor_index(ws.get("output"))
                ws_txt = ws.get("name") or tr("alttab_workspace", idx=ws.get("idx", "?"))
                meta = Gtk.Label(label=f"{w.get('app_id') or ''}  ·  {ws_txt}  ·  {col_txt}", xalign=1.0)
                meta.get_style_context().add_class("alttab-row-meta")
                row.pack_start(self._app_icon(w.get("app_id") or ""), False, False, 0)
                row.pack_start(t, True, True, 0)
                row.pack_end(meta, False, False, 0)
                if mon_idx >= 0 and len(self.ctl.outputs) > 1:
                    mon_lbl = Gtk.Label(label=monitor_badge(mon_idx))
                    mon_lbl.get_style_context().add_class("alttab-row-monitor")
                    row.pack_end(mon_lbl, False, False, 0)
                ev = Gtk.EventBox()
                ev.add(row)
                ev.connect("button-press-event", lambda *_a, i=idx: self._on_row_click(i))
                self.list_box.pack_start(ev, False, False, 0)

        def _render(self) -> None:
            if self.win is None or not self.order:
                return
            names = load_custom_names()
            w = self.ctl.windows[self.order[self.sel]]
            title, is_custom = self.ctl._format_label_for_window(w, names)
            ws = self.ctl.workspaces.get(w.get("workspace_id")) or {}
            self._render_monitor_map(ws.get("output"))
            self._render_header(w)
            self.sel_lbl.set_text(("🏷️ " if is_custom else "") + title)
            ctx = self.sel_lbl.get_style_context()
            (ctx.add_class if is_custom else ctx.remove_class)("custom-named")
            self._render_strip(w)
            self._render_rows(names)
            self.win.show_all()

    controller = BadgeController()
    alttab = AltTabSwitcher(controller)
    controller.alttab_active = lambda: alttab.active
    signal.signal(SIG_ALTTAB_NEXT, lambda *_: GLib.idle_add(alttab.step, 1))
    signal.signal(SIG_ALTTAB_PREV, lambda *_: GLib.idle_add(alttab.step, -1))
    signal.signal(
        signal.SIGUSR1, lambda *_: GLib.idle_add(controller.show_for_window, controller.focused_id, True)
    )
    signal.signal(signal.SIGUSR2, lambda *_: GLib.idle_add(controller.peek_all_visible))

    initial_state = {"done": False}

    def on_workspaces_changed(payload: dict) -> None:
        ws_list = payload.get("workspaces", [])
        controller.workspaces = {ws["id"]: ws for ws in ws_list}

    def on_windows_changed(payload: dict) -> None:
        w_list = payload.get("windows", [])
        controller.windows = {w["id"]: w for w in w_list}
        controller.workspace_view_x.clear()
        for w in w_list:
            if w.get("is_focused"):
                controller.focused_id = w["id"]
        controller.sync_all_pty_titles()
        if not initial_state["done"]:
            initial_state["done"] = True
            GLib.idle_add(controller.show_for_window, controller.focused_id)

    def on_window_opened_or_changed(payload: dict) -> None:
        w = payload.get("window", {})
        wid = w.get("id")
        if wid is None:
            return
        prev_focused = controller.focused_id
        controller.windows[wid] = w
        controller.sync_window_pty_title(w, load_custom_names())
        if w.get("is_focused"):
            w["focus_timestamp"] = monotonic_timestamp()
            controller.focused_id = wid
            if prev_focused != wid:
                GLib.idle_add(controller.show_for_window, wid)

    def on_window_layouts_changed(payload: dict) -> None:
        changes = payload.get("changes", [])
        valid_pairs = [item for item in changes if isinstance(item, list) and len(item) == 2]
        moved = any(controller._apply_single_layout_change(wid, layout) for wid, layout in valid_pairs)
        if moved and controller.focused_id is not None:
            GLib.idle_add(controller.show_for_window, controller.focused_id)

    def on_window_closed(payload: dict) -> None:
        wid = payload.get("id")
        controller.windows.pop(wid, None)
        controller.forced_side.pop(wid, None)

    def on_overview_changed(payload: dict) -> None:
        is_open = bool(payload.get("is_open"))
        controller.overview_open = is_open
        if is_open:
            GLib.idle_add(controller.hide_all)

    def on_window_focus_changed(payload: dict) -> None:
        wid = payload.get("id")
        if wid != controller.focused_id:
            controller.forced_side.clear()
        controller.focused_id = wid
        if wid in controller.windows:
            controller.windows[wid]["focus_timestamp"] = monotonic_timestamp()
            ws_id = controller.windows[wid].get("workspace_id")
            if ws_id in controller.workspaces:
                controller.workspaces[ws_id]["active_window_id"] = wid
        GLib.idle_add(controller.show_for_window, wid)

    def on_focus_timestamp_changed(payload: dict) -> None:
        wid = payload.get("id")
        ts = payload.get("focus_timestamp")
        if wid in controller.windows and ts:
            controller.windows[wid]["focus_timestamp"] = ts

    event_handlers = {
        "WindowFocusTimestampChanged": on_focus_timestamp_changed,
        "WorkspacesChanged": on_workspaces_changed,
        "WindowsChanged": on_windows_changed,
        "WindowOpenedOrChanged": on_window_opened_or_changed,
        "WindowLayoutsChanged": on_window_layouts_changed,
        "WindowClosed": on_window_closed,
        "OverviewOpenedOrClosed": on_overview_changed,
        "WindowFocusChanged": on_window_focus_changed,
    }

    def event_reader():
        proc = subprocess.Popen(
            ["niri", "msg", "--json", "event-stream"],
            stdout=subprocess.PIPE,
            text=True,
            bufsize=1,
        )
        for line in proc.stdout:
            line = line.strip()
            if not line:
                continue
            try:
                ev = json.loads(line)
            except Exception:
                continue
            event_key, payload = next(iter(ev.items()), (None, None))
            handler = event_handlers.get(event_key)
            if handler:
                handler(payload)

    t = threading.Thread(target=event_reader, daemon=True)
    t.start()

    try:
        Gtk.main()
    finally:
        PID_FILE.unlink(missing_ok=True)


def cmd_restart() -> int:
    if PID_FILE.exists():
        try:
            old_pid = int(PID_FILE.read_text().strip())
            os.kill(old_pid, signal.SIGTERM)
            time.sleep(0.2)
        except Exception:
            pass
    subprocess.run(
        ["niri", "msg", "action", "spawn", "--", str(Path(__file__).resolve()), "daemon"],
        check=False,
    )
    print(tr("restarted_msg"))
    return 0


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "daemon"
    commands = {
        "daemon": lambda: run_daemon(),
        "restart": lambda: sys.exit(cmd_restart()),
        "rename": lambda: sys.exit(cmd_rename(sys.argv[2:])),
        "switcher": lambda: sys.exit(cmd_switcher()),
        "css": lambda: sys.stdout.write(DEFAULT_CSS.decode()),
        "alt-tab": lambda: notify_daemon(
            SIG_ALTTAB_PREV if "--reverse" in sys.argv[2:] else SIG_ALTTAB_NEXT
        ),
        "peek": lambda: notify_daemon(signal.SIGUSR2),
        "show": lambda: notify_daemon(signal.SIGUSR1),
    }
    action = commands.get(cmd)
    if not action:
        print(tr("usage"))
        sys.exit(1)
    action()


if __name__ == "__main__":
    main()
