def detect_language(env: dict[str, str] | None = None) -> str:
    """Detect active UI language code ('es' or 'en') from environment variables."""
    source = env if env is not None else os.environ
    raw = (
        source.get("NIRI_LABEL_LANG")
        or source.get("LC_ALL")
        or source.get("LC_MESSAGES")
        or source.get("LANG")
        or "en"
    )
    code = raw.split(".")[0].split("_")[0].lower()
    return code if code in TRANSLATIONS else "en"


def tr(key: str, lang: str | None = None, **kwargs) -> str:
    """Translate a UI message key into the active or specified language with English fallback."""
    active_lang = lang if lang in TRANSLATIONS else detect_language()
    template = TRANSLATIONS.get(active_lang, {}).get(key) or TRANSLATIONS["en"].get(key, key)
    return template.format(**kwargs) if kwargs else template


