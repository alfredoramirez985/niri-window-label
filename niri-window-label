#!/usr/bin/env python3
"""
niri-window-label: Visual window identifier and custom renamer for the Niri compositor.
Supports multiple monitors, centers the overlay pill on the active window (including
half-width and vertically stacked tiles), and allows assigning custom names.
"""

import itertools
import json
import os
import signal
import subprocess
import sys
import threading
import time
from pathlib import Path

CONFIG_DIR = Path.home() / ".config" / "niri"
NAMES_FILE = CONFIG_DIR / "window-names.json"
STYLE_FILE = CONFIG_DIR / "window-label.css"
PID_FILE = Path(f"/run/user/{os.getuid()}/niri-window-label.pid")

TRANSLATIONS: dict[str, dict[str, str]] = {
    "en": {
