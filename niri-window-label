def build_stylesheet(
    default_css: bytes, custom_path: Path | None = None, theme_path: Path | None = None
) -> bytes:
    """Layer the stylesheets: built-in defaults, then the theme-generated
    window-label.theme.css, then the user's window-label.css (which always wins)."""
    layers = [
        theme_path if theme_path is not None else THEME_STYLE_FILE,
        custom_path if custom_path is not None else STYLE_FILE,
    ]
    css = default_css
    for layer in layers:
        try:
            if layer.exists():
                css += b"\n" + layer.read_bytes()
        except Exception:
            pass
    return css


def truncate_text(text: str, max_len: int) -> str:
    if len(text) <= max_len:
        return text
    return text[: max_len - 1].rstrip() + "…"


def strip_minimap_from_title(raw_title: str) -> str:
    """Remove any injected '🏷️ ' prefix and trailing '   ⟪...⟫' minimap strip from a window title."""
    cleaned = raw_title.strip()
    if "⟪" in cleaned and cleaned.endswith("⟫"):
        cleaned = cleaned.rsplit("⟪", 1)[0].rstrip()
    if cleaned.startswith("🏷️"):
        cleaned = cleaned.lstrip("🏷️").strip()
    return cleaned


def load_custom_names() -> dict[str, str]:
    try:
        if NAMES_FILE.exists():
            return json.loads(NAMES_FILE.read_text(encoding="utf-8"))
    except Exception:
        pass
    return {}


def save_custom_names(names: dict[str, str]) -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    NAMES_FILE.write_text(json.dumps(names, indent=2, ensure_ascii=False), encoding="utf-8")


