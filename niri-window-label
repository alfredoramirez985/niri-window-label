        "rename_placeholder": "Type new window name here...",
        "rename_hint": "Enter = save new name   •   Empty + Enter = restore original   •   Esc = cancel",
        "err_focused_win": "Error getting focused window: {err}",
        "no_focused_win": "No focused window found.",
        "untitled": "Untitled",
        "search_window": "🔎 Search window",
        "restarted_msg": "✓ niri-window-label restarted in background.",
        "usage": "Usage: niri-window-label [daemon|restart|rename|switcher|peek|show]",
    },
    "es": {
